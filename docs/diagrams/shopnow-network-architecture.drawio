        <mxCell id="e1" value="Default gateway" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="client" target="onprem-vpn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="260"/><mxPoint x="370" y="672"/></Array></mxGeometry></mxCell>
