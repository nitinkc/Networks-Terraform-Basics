        <mxCell id="orders" value="orders Service + Pods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="gke"><mxGeometry x="90" y="350" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="inventory" value="inventory Service + Pods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="gke"><mxGeometry x="90" y="490" width="240" height="70" as="geometry"/></mxCell>
