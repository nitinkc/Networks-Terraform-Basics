<mxfile host="Electron">
  <diagram id="shopnow-vpn-private" name="ShopNow VPN-Only Architecture">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="ShopNow Private GCP Access — VPN Required" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="corp" value="Corporate client network · 192.168.1.0/24" style="swimlane;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=36;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="360" height="760" as="geometry"/></mxCell>
        <mxCell id="gcp" value="Google Cloud · Terraform-managed · no public application ingress" style="swimlane;html=1;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;startSize=38;fontSize=15;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="1550" height="1120" as="geometry"/></mxCell>
        <mxCell id="gke" value="Private GKE cluster" style="swimlane;html=1;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;startSize=38;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="250" width="420" height="640" as="geometry"/></mxCell>
        <mxCell id="client" value="Authorized client&lt;br&gt;Corporate-managed device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="corp"><mxGeometry x="65" y="90" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="corp-dns" value="Corporate DNS resolver&lt;br&gt;Conditional forwarding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="corp"><mxGeometry x="65" y="260" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="onprem-vpn" value="On-prem VPN gateway&lt;br&gt;IPsec + BGP/static routes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="corp"><mxGeometry x="65" y="500" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="underlay" value="Internet&lt;br&gt;VPN underlay only" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="627" width="160" height="96" as="geometry"/></mxCell>
        <mxCell id="external-client" value="Client without VPN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="95" y="970" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="denied" value="DENIED&lt;br&gt;No public endpoint&lt;br&gt;No private route or DNS" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="955" width="295" height="110" as="geometry"/></mxCell>
        <mxCell id="ha-vpn" value="HA VPN gateway&lt;br&gt;IPsec termination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="gcp"><mxGeometry x="80" y="500" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="cloud-router" value="Cloud Router&lt;br&gt;BGP route exchange" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="gcp"><mxGeometry x="400" y="500" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="private-dns" value="Private DNS + inbound forwarding&lt;br&gt;shop.internal&lt;br&gt;api.shop.internal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="gcp"><mxGeometry x="390" y="120" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="internal-lb" value="Internal HTTPS load balancer&lt;br&gt;Private IP · TCP 443&lt;br&gt;Website entry point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="gcp"><mxGeometry x="740" y="100" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="apigee" value="Private Apigee API endpoint&lt;br&gt;Authentication · quotas&lt;br&gt;Threat protection · analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="gcp"><mxGeometry x="740" y="330" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="nat" value="Cloud NAT&lt;br&gt;Outbound only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="gcp"><mxGeometry x="740" y="870" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="gateway" value="Internal Gateway / Ingress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="gke"><mxGeometry x="90" y="70" width="240" height="70" as="geometry"/></mxCell>
