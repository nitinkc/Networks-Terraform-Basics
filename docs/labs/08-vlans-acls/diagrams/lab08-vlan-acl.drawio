        <mxCell id="c85" value="&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#E2E8F0;&quot;&gt;ping 10.1.50.10&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#0B1220;strokeWidth=2;fontColor=#E2E8F0;fillColor=#1F2A44;rounded=1;absoluteArcSize=1;arcSize=36.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="884.0" width="157.0" height="36.0" as="geometry"/></mxCell>
