        <mxCell id="c89" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;OBSERVE&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="1108.0" width="89.4" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c90" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;VLANs separate broadcast domains; only the router (with ACLs) lets them communicate, so policy lives in one place.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="169.4" y="1099.0" width="981.6" height="21" as="geometry"/></mxCell>
        <mxCell id="c91" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;ACL order, direction and the implicit deny decide the result: re-read the matrix after every change.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="169.4" y="1123.0" width="864.0" height="21" as="geometry"/></mxCell>
