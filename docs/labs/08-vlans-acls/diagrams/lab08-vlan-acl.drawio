        <mxCell id="c87" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;Test every cell of the matrix — a wrong ACL direction looks identical to no ACL&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=2;fontColor=#8E1B1B;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=62.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="960.0" width="730.0" height="62.0" as="geometry"/></mxCell>
