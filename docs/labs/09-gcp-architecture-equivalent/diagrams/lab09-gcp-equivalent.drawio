        <mxCell id="c102" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2B2D8F;&quot;&gt;Design goal: only the web tier is exposed&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;The app tier and DNS live on a private VLAN; outbound access uses NAT, never inbound reachability&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#6366F1;strokeWidth=2;fontColor=#2B2D8F;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="884.0" width="930.0" height="86.0" as="geometry"/></mxCell>
