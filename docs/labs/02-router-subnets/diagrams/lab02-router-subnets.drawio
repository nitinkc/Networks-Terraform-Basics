        <mxCell id="c71" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#2F3846;&quot;&gt;unused · .192 – .255&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#2F3846;&quot;&gt;spare /26&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=2;fontColor=#2F3846;fillColor=#F1F3F6;gradientColor=#E1E4E9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="998.0" y="536.0" width="312.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="c72" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;PACKET WALK · PC1 → SERVER0&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="670.0" width="237.8" height="17" as="geometry"/></mxCell>
        <mxCell id="c73" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2B2D8F;&quot;&gt;Is .100 on my subnet?&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#6466B0;&quot;&gt;PC1 .11/26 → .100 is outside .0–.63, so use the default gateway&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#6366F1;strokeWidth=2;fontColor=#2B2D8F;fillColor=#E9EAFE;gradientColor=#D4D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=60;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="700.0" width="780.0" height="56.0" as="geometry"/></mxCell>
        <mxCell id="c74" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;1&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#3932A5;strokeWidth=2;fontColor=#FFFFFF;fillColor=#4F46E5;gradientColor=#443CC5;gradientDirection=south;ellipse;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="59.0" y="713.0" width="30.0" height="30.0" as="geometry"/></mxCell>
