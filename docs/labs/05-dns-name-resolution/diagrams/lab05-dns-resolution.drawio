        <mxCell id="c103" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Ping by IP works but ping by name fails? The problem is DNS (or the DNS server address from DHCP), not routing.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="169.4" y="1149.0" width="956.4" height="21" as="geometry"/></mxCell>
        <mxCell id="c104" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Every name lookup is a separate UDP 53 conversation that happens before the HTTP session.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="169.4" y="1173.0" width="771.6" height="21" as="geometry"/></mxCell>
