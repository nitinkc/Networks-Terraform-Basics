        <mxCell id="c87" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;DORA = Discover, Offer, Request, Ack. Broadcasts stop at routers, so a relay converts them to unicast.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1069.0" width="880.8" height="21" as="geometry"/></mxCell>
        <mxCell id="c88" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;giaddr tells the server which subnet the client is on, so it hands out an address from the right pool.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1093.0" width="880.8" height="21" as="geometry"/></mxCell>
