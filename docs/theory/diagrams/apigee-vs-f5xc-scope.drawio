        <mxCell id="c6" value="CONSUMERS" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=12;html=1;collapsible=0;fillColor=#2F6FE0;gradientColor=#285FC1;swimlaneFillColor=#E8F1FF;strokeColor=#4C8DF6;strokeWidth=2.5;fontColor=#FFFFFF;fontStyle=1;fontSize=17;align=left;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="130" width="1272" height="150" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;End user&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#6079B4;&quot;&gt;browser / mobile app&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="70.0" y="184.0" width="300.0" height="76.0" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;Partner developer&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#6079B4;&quot;&gt;API key + OAuth client&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="400.0" y="184.0" width="300.0" height="76.0" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;Machine client&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#6079B4;&quot;&gt;service to service&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="730.0" y="184.0" width="300.0" height="76.0" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;Identity differs&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;XC: IP, TLS, requests&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;Apigee: app, product, tier&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=2;fontColor=#8E1B1B;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1070.0" y="184.0" width="220.0" height="76.0" as="geometry"/></mxCell>
        <mxCell id="c11" value="F5 XC · delivery &amp; edge security" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=12;html=1;collapsible=0;fillColor=#E8890C;gradientColor=#C8760A;swimlaneFillColor=#FFF0DC;strokeColor=#F5A524;strokeWidth=2.5;fontColor=#FFFFFF;fontStyle=1;fontSize=17;align=left;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="330" width="620" height="560" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Anycast VIP + DNS&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27B4C;&quot;&gt;global entry point on every RE&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="70.0" y="388.0" width="568.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;TLS + WAF + DDoS&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27B4C;&quot;&gt;terminate, inspect, block · signatures · bots&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="70.0" y="480.0" width="568.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;L4/L7 load balancing&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27B4C;&quot;&gt;origin pools · health checks · TCP and HTTP&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="70.0" y="572.0" width="568.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Site fabric&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27B4C;&quot;&gt;CE tunnels into VPCs — backends need NO public IPs · multi-cloud&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="70.0" y="664.0" width="568.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Knows:&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;VIPs, sites, IPs, requests, attack patterns&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;Does NOT know what an “API product” is&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFF0DC;gradientColor=#FDE4BF;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="70.0" y="758.0" width="568.0" height="110.0" as="geometry"/></mxCell>
        <mxCell id="c17" value="Apigee · API governance" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=12;html=1;collapsible=0;fillColor=#7C4DDB;gradientColor=#6B42BC;swimlaneFillColor=#F1E9FE;strokeColor=#9B6CF0;strokeWidth=2.5;fontColor=#FFFFFF;fontStyle=1;fontSize=17;align=left;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="696" y="330" width="620" height="560" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;API proxies&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#816AB8;&quot;&gt;versioned façades in front of backends&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="722.0" y="388.0" width="568.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Policy engine&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#816AB8;&quot;&gt;OAuth · API key · JWT · quota · spike arrest · CORS&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="722.0" y="480.0" width="568.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Mediation&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#816AB8;&quot;&gt;transform payloads · SOAP ↔ REST · mashups&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="722.0" y="572.0" width="568.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Developer platform&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#816AB8;&quot;&gt;portal · products · apps · analytics · monetization&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="722.0" y="664.0" width="568.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Knows:&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;developers, apps, products, quotas, payload shapes&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;Does NOT build network paths to your backends&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#F1E9FE;gradientColor=#E3D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="722.0" y="758.0" width="568.0" height="110.0" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2F3846;&quot;&gt;Overlap zone — both terminate TLS, rate-limit, and allow/deny&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;a coincidence of edge protocols: choose by the problem (governance vs delivery &amp;amp; security), not by the shared verbs&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=2;fontColor=#2F3846;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="914.0" width="1272.0" height="70.0" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;THE COMBINED PATTERN&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="1016.0" width="182.4" height="17" as="geometry"/></mxCell>
