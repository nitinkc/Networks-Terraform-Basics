        <mxCell id="c30" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;Private origins&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#508D72;&quot;&gt;GKE / CE / legacy&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1010.0" y="1052.0" width="270.0" height="84.0" as="geometry"/></mxCell>
