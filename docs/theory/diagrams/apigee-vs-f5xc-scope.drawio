        <mxCell id="c28" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Apigee runtime&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#7D63B8;&quot;&gt;key · quota · product&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#F1E9FE;gradientColor=#E3D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="1052.0" width="270.0" height="84.0" as="geometry"/></mxCell>
