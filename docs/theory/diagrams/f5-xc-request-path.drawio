        <mxCell id="c24" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;6 · return path: response retraces the same tunnel&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#166F47;strokeWidth=1.5;fontColor=#FFFFFF;fillColor=#1E9A63;rounded=1;absoluteArcSize=1;arcSize=26.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="434.0" y="277.0" width="440.0" height="26.0" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;WHAT EACH STAGE DECIDES&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="336.0" width="206.2" height="17" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;DNS → VIP&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Decides WHICH edge serves it&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#7D63B8;&quot;&gt;TCP + TLS to the nearest PoP. The&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#7D63B8;&quot;&gt;origin never sees the session.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#4B2A9A;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#4B2A9A;&quot;&gt;http_loadbalancer.domains&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#F1E9FE;gradientColor=#E3D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="372.0" width="306.0" height="230.0" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Edge policy&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Decides MAY this request pass&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27742;&quot;&gt;WAF signatures, threat campaigns,&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27742;&quot;&gt;service policy allow/deny, rate&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27742;&quot;&gt;limits, bot rules.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#7A4300;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#7A4300;&quot;&gt;app_firewall · service_policy&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFF0DC;gradientColor=#FDE4BF;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="362.0" y="372.0" width="306.0" height="230.0" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#8A1E56;&quot;&gt;Origin pool&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8A1E56;&quot;&gt;Decides WHICH backend serves it&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#AD5B85;&quot;&gt;Healthy endpoints only;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#AD5B85;&quot;&gt;endpoint_selection = LOCAL_PREFERRED&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#AD5B85;&quot;&gt;picks the nearest site.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#8A1E56;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#8A1E56;&quot;&gt;origin_pool · healthcheck&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EC5FA5;strokeWidth=2;fontColor=#8A1E56;fillColor=#FFE8F3;gradientColor=#FCD2E7;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="680.0" y="372.0" width="306.0" height="230.0" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#0B5E5A;&quot;&gt;Tunnel + SLI&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#0B5E5A;&quot;&gt;Decides HOW to reach the site&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#4B8C88;&quot;&gt;RE tunnel ends on the SLO; the CE&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#4B8C88;&quot;&gt;forwards inward from its SLI address&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#4B8C88;&quot;&gt;(SNAT).&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#0B5E5A;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#0B5E5A;&quot;&gt;site (gcp_vpc_site)&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#20B2AA;strokeWidth=2;fontColor=#0B5E5A;fillColor=#DFF6F5;gradientColor=#C0EBE9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="998.0" y="372.0" width="306.0" height="230.0" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;WHERE EACH FAILURE SHOWS UP&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="640.0" width="237.8" height="17" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Wrong DNS / domain&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#816AB8;&quot;&gt;name does not resolve, or resolves&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#816AB8;&quot;&gt;to the wrong VIP&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#4B2A9A;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;check: nslookup lb.example.com&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="676.0" width="306.0" height="150.0" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;WAF / policy block&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27B4C;&quot;&gt;HTTP 403 with a support ID from&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27B4C;&quot;&gt;the edge&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#7A4300;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;check: security events in Console&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="362.0" y="676.0" width="306.0" height="150.0" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#0B5E5A;&quot;&gt;Site down / unreachable&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#548E8C;&quot;&gt;no healthy endpoint → HTTP 503&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#0B5E5A;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#0B5E5A;&quot;&gt;check: site status SLO / SLI UP&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#20B2AA;strokeWidth=2;fontColor=#0B5E5A;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="680.0" y="676.0" width="306.0" height="150.0" as="geometry"/></mxCell>
        <mxCell id="c34" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#8A1E56;&quot;&gt;Origin down / firewall drop&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#AD6289;&quot;&gt;health check fails, endpoint&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#AD6289;&quot;&gt;removed&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#8A1E56;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8A1E56;&quot;&gt;check: firewall logs + pool&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EC5FA5;strokeWidth=2;fontColor=#8A1E56;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="998.0" y="676.0" width="306.0" height="150.0" as="geometry"/></mxCell>
        <mxCell id="c35" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2B2D8F;&quot;&gt;Debugging rule: failures surface one stage EARLY&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;a dead origin looks like a site problem, a dead site looks like a load-balancer problem — name the symptom, then walk stages 1 → 6&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#6366F1;strokeWidth=2;fontColor=#2B2D8F;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="860.0" width="1272.0" height="84.0" as="geometry"/></mxCell>
        <mxCell id="c36" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#E6C229;strokeWidth=2;fontColor=#5F4C00;fillColor=#FFF8D6;gradientColor=#FBEFBA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="954.0" width="1272.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c37" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;REMEMBER&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="978.0" width="97.4" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Two XC-specific checkpoints sit on top of the usual four-question loop: the WAF at the edge and the tunnel to the site.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="969.0" width="1023.6" height="21" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Resolution (stage 1) · Routing (2/4/5) · Policy (3/5) · Application (origin) — the same method you used in the packet-tracer labs.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="993.0" width="1116.0" height="21" as="geometry"/></mxCell>
      </root>
