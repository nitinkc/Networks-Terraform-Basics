        <mxCell id="c39" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;802.1Q TRUNK · VLAN 10 + 20 (tagged)&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#59379E;strokeWidth=1.5;fontColor=#FFFFFF;fillColor=#7C4DDB;rounded=1;absoluteArcSize=1;arcSize=26.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="518.8" y="372.0" width="322.4" height="26.0" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;Same VLAN = same L2 network&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;PC-A reaches PC-C over the trunk&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;with no router involved&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="360.0" y="160.0" width="300.0" height="100.0" as="geometry"/></mxCell>
        <mxCell id="c41" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;Different VLAN = different net&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;PC-A to PC-B must be routed&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;(a router or L3 switch)&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=2;fontColor=#8E1B1B;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="700.0" y="160.0" width="300.0" height="100.0" as="geometry"/></mxCell>
