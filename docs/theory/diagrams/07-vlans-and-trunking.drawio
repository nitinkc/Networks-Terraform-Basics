        <mxCell id="c76" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;REMEMBER&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="998.0" width="97.4" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c77" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;VLAN = broadcast domain = (normally) one subnet. Trunk carries them all; the tag says which VLAN each frame belongs to.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="989.0" width="1023.6" height="21" as="geometry"/></mxCell>
        <mxCell id="c78" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Traffic between VLANs MUST be routed (router-on-a-stick or Layer 3 switch). ACLs on that router become the policy point.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1013.0" width="1032.0" height="21" as="geometry"/></mxCell>
