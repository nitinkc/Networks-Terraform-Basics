        <mxCell id="c47" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#0B5E5A;&quot;&gt;Lowest metric&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#4B8C88;&quot;&gt;OSPF cost, BGP policy attrs&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#20B2AA;strokeWidth=2;fontColor=#0B5E5A;fillColor=#DFF6F5;gradientColor=#C0EBE9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=70;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="760.0" y="832.0" width="556.0" height="66.0" as="geometry"/></mxCell>
        <mxCell id="c48" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;3&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#0D6863;strokeWidth=2;fontColor=#FFFFFF;fillColor=#12908A;gradientColor=#0F7C77;gradientDirection=south;ellipse;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="785.0" y="850.0" width="30.0" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c49" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;Control plane&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;Builds the routing table (OSPF, BGP, static routes)&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;Slow, software, decides WHERE&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="940.0" width="600.0" height="100.0" as="geometry"/></mxCell>
