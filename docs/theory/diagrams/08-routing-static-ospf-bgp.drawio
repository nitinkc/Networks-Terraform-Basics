        <mxCell id="c43" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;Longest prefix match&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#AF5858;&quot;&gt;/26 beats /24 beats /0&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=2;fontColor=#8E1B1B;fillColor=#FDE8E8;gradientColor=#FBD1D1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=70;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="760.0" y="672.0" width="556.0" height="66.0" as="geometry"/></mxCell>
