        <mxCell id="c38" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;NETWORK PART  192.168.1.0  — identical for every device on this LAN&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=56.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="752.0" width="936.0" height="56.0" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;HOST PART  .77&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=56.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="992.0" y="752.0" width="304.0" height="56.0" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2F3846;&quot;&gt;Network address&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#2F3846;&quot;&gt;192.168.1.0&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#69707B;&quot;&gt;all host bits 0&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=2;fontColor=#2F3846;fillColor=#F1F3F6;gradientColor=#E1E4E9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="828.0" width="304.0" height="86.0" as="geometry"/></mxCell>
        <mxCell id="c41" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#0B5E5A;&quot;&gt;First usable&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#0B5E5A;&quot;&gt;192.168.1.1&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#4B8C88;&quot;&gt;usually the gateway&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#20B2AA;strokeWidth=2;fontColor=#0B5E5A;fillColor=#DFF6F5;gradientColor=#C0EBE9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="360.0" y="828.0" width="304.0" height="86.0" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#0B5E5A;&quot;&gt;Last usable&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#0B5E5A;&quot;&gt;192.168.1.254&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#4B8C88;&quot;&gt;2^8 − 2 = 254 hosts&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#20B2AA;strokeWidth=2;fontColor=#0B5E5A;fillColor=#DFF6F5;gradientColor=#C0EBE9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="676.0" y="828.0" width="304.0" height="86.0" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Broadcast&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;192.168.1.255&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27742;&quot;&gt;all host bits 1&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFF0DC;gradientColor=#FDE4BF;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="992.0" y="828.0" width="304.0" height="86.0" as="geometry"/></mxCell>
        <mxCell id="c44" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#E6C229;strokeWidth=2;fontColor=#5F4C00;fillColor=#FFF8D6;gradientColor=#FBEFBA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="944.0" width="1272.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c45" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;REMEMBER&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="968.0" width="97.4" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c46" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Mask = where the network ends. /24 → 8 host bits → 256 − 2 usable.  Bigger prefix number = smaller network.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="959.0" width="922.8" height="21" as="geometry"/></mxCell>
        <mxCell id="c47" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Router rule: compare destination to routing-table prefixes, longest match wins, TTL − 1, forward.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="983.0" width="838.8" height="21" as="geometry"/></mxCell>
      </root>
