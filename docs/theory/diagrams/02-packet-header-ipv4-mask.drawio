        <mxCell id="c3" value="&lt;div style=&quot;font-size:32px;line-height:40px;font-weight:700;font-family:Helvetica;color:#1F2A44;&quot;&gt;Anatomy of a packet and how an IPv4 address is read&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="28.0" width="1060.0" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;font-size:17px;line-height:24px;font-family:Helvetica;color:#5B6677;&quot;&gt;A header tells every router what to do; the mask splits an address into &#x27;which network&#x27; and &#x27;which host&#x27;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="72.0" width="1060.0" height="24" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;STAGE 02 · PACKETS &amp;amp; IP&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#3932A5;strokeWidth=2;fontColor=#FFFFFF;fillColor=#4F46E5;gradientColor=#443CC5;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1093.8" y="30.0" width="222.2" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;1 · IPV4 HEADER (20 BYTES, 32 BITS PER ROW)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="116.0" width="364.6" height="17" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#1C3F94;&quot;&gt;Version&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=1.8;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="152.0" width="87.5" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#1C3F94;&quot;&gt;IHL&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=1.8;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="131.5" y="152.0" width="87.5" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#1C3F94;&quot;&gt;DSCP / ECN&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=1.8;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="219.0" y="152.0" width="175.0" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#1C3F94;&quot;&gt;Total length&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=1.8;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="394.0" y="152.0" width="350.0" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Identification&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=1.8;fontColor=#4B2A9A;fillColor=#F1E9FE;gradientColor=#E3D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="202.0" width="350.0" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Flags&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=1.8;fontColor=#4B2A9A;fillColor=#F1E9FE;gradientColor=#E3D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="394.0" y="202.0" width="65.6" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Fragment offset&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=1.8;fontColor=#4B2A9A;fillColor=#F1E9FE;gradientColor=#E3D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="459.6" y="202.0" width="284.4" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#8E1B1B;&quot;&gt;TTL — hop limit&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=1.8;fontColor=#8E1B1B;fillColor=#FDE8E8;gradientColor=#FBD1D1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="252.0" width="175.0" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#7A4300;&quot;&gt;Protocol (TCP=6)&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=1.8;fontColor=#7A4300;fillColor=#FFF0DC;gradientColor=#FDE4BF;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="219.0" y="252.0" width="175.0" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#2F3846;&quot;&gt;Header checksum&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=1.8;fontColor=#2F3846;fillColor=#F1F3F6;gradientColor=#E1E4E9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="394.0" y="252.0" width="350.0" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#11603E;&quot;&gt;Source IP address&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=1.8;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="302.0" width="700.0" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#0B5E5A;&quot;&gt;Destination IP address&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#20B2AA;strokeWidth=1.8;fontColor=#0B5E5A;fillColor=#DFF6F5;gradientColor=#C0EBE9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="352.0" width="700.0" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#2F3846;&quot;&gt;Options + padding (rare)&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=1.8;fontColor=#2F3846;fillColor=#F1F3F6;gradientColor=#E1E4E9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="402.0" width="700.0" height="46.0" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;Routers read only this part (Layer 3) — they never look inside the payload.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="456.0" width="531.0" height="18" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=2;fontColor=#8E1B1B;fillColor=#FDE8E8;gradientColor=#FBD1D1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="780.0" y="152.0" width="536.0" height="148.0" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;TTL — the loop breaker&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#8E1B1B;&quot;&gt;Every router subtracts 1.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#8E1B1B;&quot;&gt;At 0 the packet is dropped and an&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#8E1B1B;&quot;&gt;ICMP &#x27;time exceeded&#x27; is sent back.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;traceroute exploits exactly this.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="800.0" y="164.0" width="289.2" height="110" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#D93F3F;&quot;&gt;64&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#B05F5F;&quot;&gt;start&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#8E1B1B;&quot;&gt;→ 63 → 62 → …&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=2;fontColor=#8E1B1B;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1130.0" y="170.0" width="164.0" height="112.0" as="geometry"/></mxCell>
        <mxCell id="c24" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFF0DC;gradientColor=#FDE4BF;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="780.0" y="316.0" width="536.0" height="90.0" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Protocol — who gets the payload?&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#7A4300;&quot;&gt;6 → TCP   17 → UDP   1 → ICMP   89 → OSPF&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="800.0" y="326.0" width="346.6" height="47" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;The value tells the receiving host which Layer-4 handler to hand the data to.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="800.0" y="380.0" width="544.5" height="18" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;2 · READING AN ADDRESS WITH ITS MASK  (192.168.1.77 / 24)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="500.0" width="475.4" height="17" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;192&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#1C3F94;&quot;&gt;11000000&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="538.0" width="304.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;168&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#1C3F94;&quot;&gt;10101000&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="360.0" y="538.0" width="304.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;1&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#1C3F94;&quot;&gt;00000001&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="676.0" y="538.0" width="304.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;77&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#11603E;&quot;&gt;01001101&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="992.0" y="538.0" width="304.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#5B6677;letter-spacing:1.2px;&quot;&gt;IP ADDRESS&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="630.0" width="103.2" height="17" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#FFFFFF;&quot;&gt;11111111&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#2250A1;strokeWidth=2;fontColor=#FFFFFF;fillColor=#2F6FE0;gradientColor=#285FC1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="658.0" width="304.0" height="52.0" as="geometry"/></mxCell>
        <mxCell id="c34" value="&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#FFFFFF;&quot;&gt;11111111&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#2250A1;strokeWidth=2;fontColor=#FFFFFF;fillColor=#2F6FE0;gradientColor=#285FC1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="360.0" y="658.0" width="304.0" height="52.0" as="geometry"/></mxCell>
        <mxCell id="c35" value="&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#FFFFFF;&quot;&gt;11111111&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#2250A1;strokeWidth=2;fontColor=#FFFFFF;fillColor=#2F6FE0;gradientColor=#285FC1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="676.0" y="658.0" width="304.0" height="52.0" as="geometry"/></mxCell>
        <mxCell id="c36" value="&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#FFFFFF;&quot;&gt;00000000&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#166F47;strokeWidth=2;fontColor=#FFFFFF;fillColor=#1E9A63;gradientColor=#1A8455;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="992.0" y="658.0" width="304.0" height="52.0" as="geometry"/></mxCell>
