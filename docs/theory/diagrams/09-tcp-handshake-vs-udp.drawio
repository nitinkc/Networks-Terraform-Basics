        <mxCell id="c39" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;datagram 1  (query)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="966.2" y="305.0" width="183.6" height="21" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;no handshake first&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="975.8" y="336.0" width="164.4" height="21" as="geometry"/></mxCell>
        <mxCell id="c41" value="" style="html=1;strokeColor=#1E9A63;strokeWidth=3.5;rounded=1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205.0" y="420.0" as="sourcePoint"/><mxPoint x="911.0" y="420.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c42" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;datagram 2  (answer)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="962.0" y="395.0" width="192.0" height="21" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;no ACK needed&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="995.3" y="426.0" width="125.4" height="21" as="geometry"/></mxCell>
        <mxCell id="c44" value="" style="html=1;strokeColor=#D93F3F;strokeWidth=3.5;rounded=1;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="911.0" y="520.0" as="sourcePoint"/><mxPoint x="1071.0" y="520.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c45" value="" style="html=1;strokeColor=#D93F3F;strokeWidth=5;rounded=1;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1073.0" y="506.0" as="sourcePoint"/><mxPoint x="1101.0" y="534.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c46" value="" style="html=1;strokeColor=#D93F3F;strokeWidth=5;rounded=1;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1073.0" y="534.0" as="sourcePoint"/><mxPoint x="1101.0" y="506.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c47" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;datagram 3 — lost&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1116.0" y="494.0" width="166.8" height="21" as="geometry"/></mxCell>
        <mxCell id="c48" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;Nobody retransmits for you&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;The application decides: retry (DNS) or skip the&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;missing frame (live video, voice, games)&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=2;fontColor=#8E1B1B;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="832.0" y="560.0" width="460.0" height="84.0" as="geometry"/></mxCell>
        <mxCell id="c49" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Why bother?  Speed and simplicity&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;8-byte header, no waiting, works with broadcast&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;and multicast, perfect for small request/response&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="832.0" y="664.0" width="460.0" height="84.0" as="geometry"/></mxCell>
        <mxCell id="c50" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;HEADERS — HOW MUCH EACH PROTOCOL ADDS&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="800.0" width="317.0" height="17" as="geometry"/></mxCell>
        <mxCell id="c51" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#1C3F94;&quot;&gt;Src port&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=1.8;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="836.0" width="89.5" height="48.0" as="geometry"/></mxCell>
        <mxCell id="c52" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#1C3F94;&quot;&gt;Dst port&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=1.8;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="133.5" y="836.0" width="89.5" height="48.0" as="geometry"/></mxCell>
