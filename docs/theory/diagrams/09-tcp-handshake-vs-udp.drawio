        <mxCell id="c34" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;Client&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#5B6677;&quot;&gt;port 49152&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="826.0" y="188.0" width="170.0" height="64.0" as="geometry"/></mxCell>
