        <mxCell id="c54" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Ack number&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=1.8;fontColor=#4B2A9A;fillColor=#F1E9FE;gradientColor=#E3D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="372.2" y="836.0" width="149.2" height="48.0" as="geometry"/></mxCell>
        <mxCell id="c55" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#8E1B1B;&quot;&gt;Flags&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=1.8;fontColor=#8E1B1B;fillColor=#FDE8E8;gradientColor=#FBD1D1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="521.3" y="836.0" width="119.3" height="48.0" as="geometry"/></mxCell>
        <mxCell id="c56" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#2F3846;&quot;&gt;Window&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=1.8;fontColor=#2F3846;fillColor=#F1F3F6;gradientColor=#E1E4E9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="640.7" y="836.0" width="119.3" height="48.0" as="geometry"/></mxCell>
        <mxCell id="c57" value="&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;TCP header: 20+ bytes — sequence and ack numbers enable ordering, retransmission and flow control&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="890.0" width="679.7" height="18" as="geometry"/></mxCell>
        <mxCell id="c58" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#1C3F94;&quot;&gt;Src port&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=1.8;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="800.0" y="836.0" width="154.8" height="48.0" as="geometry"/></mxCell>
        <mxCell id="c59" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#1C3F94;&quot;&gt;Dst port&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=1.8;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="954.8" y="836.0" width="154.8" height="48.0" as="geometry"/></mxCell>
        <mxCell id="c60" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#7A4300;&quot;&gt;Length&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=1.8;fontColor=#7A4300;fillColor=#FFF0DC;gradientColor=#FDE4BF;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1109.6" y="836.0" width="103.2" height="48.0" as="geometry"/></mxCell>
        <mxCell id="c61" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#2F3846;&quot;&gt;Checksum&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=1.8;fontColor=#2F3846;fillColor=#F1F3F6;gradientColor=#E1E4E9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1212.8" y="836.0" width="103.2" height="48.0" as="geometry"/></mxCell>
        <mxCell id="c62" value="&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;UDP header: 8 bytes — ports, length, checksum. That&#x27;s all.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="800.0" y="890.0" width="416.1" height="18" as="geometry"/></mxCell>
        <mxCell id="c63" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#2250A1;strokeWidth=1;fontColor=#FFFFFF;fillColor=#2F6FE0;gradientColor=#285FC1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="930.0" width="180.0" height="38.0" as="geometry"/></mxCell>
        <mxCell id="c64" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;TCP — use when every byte must arrive&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#2250A1;strokeWidth=1;fontColor=#FFFFFF;fillColor=#2F6FE0;gradientColor=#285FC1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="224.0" y="930.0" width="530.0" height="38.0" as="geometry"/></mxCell>
        <mxCell id="c65" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;UDP — use when speed beats perfection&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#2250A1;strokeWidth=1;fontColor=#FFFFFF;fillColor=#2F6FE0;gradientColor=#285FC1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="754.0" y="930.0" width="562.0" height="38.0" as="geometry"/></mxCell>
        <mxCell id="c66" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#2F3846;&quot;&gt;Examples&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=1;fontColor=#2F3846;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="968.0" width="180.0" height="38.0" as="geometry"/></mxCell>
        <mxCell id="c67" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#2F3846;&quot;&gt;HTTP/HTTPS · SSH · email · file transfer · databases&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=1;fontColor=#2F3846;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="224.0" y="968.0" width="530.0" height="38.0" as="geometry"/></mxCell>
        <mxCell id="c68" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#2F3846;&quot;&gt;DNS · DHCP · VoIP · video calls · online games · QUIC&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=1;fontColor=#2F3846;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="754.0" y="968.0" width="562.0" height="38.0" as="geometry"/></mxCell>
        <mxCell id="c69" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#E6C229;strokeWidth=2;fontColor=#5F4C00;fillColor=#FFF8D6;gradientColor=#FBEFBA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="1024.0" width="1272.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c70" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;REMEMBER&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="1048.0" width="97.4" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c71" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;TCP = SYN, SYN-ACK, ACK, then numbered data with ACKs and retransmits.  UDP = just send it.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1039.0" width="788.4" height="21" as="geometry"/></mxCell>
        <mxCell id="c72" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Neither is &#x27;better&#x27;: pick reliability (TCP) or low latency (UDP) based on what the application can tolerate losing.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1063.0" width="990.0" height="21" as="geometry"/></mxCell>
