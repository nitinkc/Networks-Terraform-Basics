        <mxCell id="c80" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Stateful = a table of established connections. Reply traffic is allowed because the firewall remembers the request.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="999.0" width="990.0" height="21" as="geometry"/></mxCell>
        <mxCell id="c81" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Default posture: deny everything crossing zones, then permit only what each application genuinely needs.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1023.0" width="897.6" height="21" as="geometry"/></mxCell>
