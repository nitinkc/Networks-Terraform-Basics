        <mxCell id="c26" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Needs TWO rules to work&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#7A4300;&quot;&gt;1 permit tcp inside → any eq 443&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#7A4300;&quot;&gt;2 permit tcp any eq 443 → inside  (reply rule, risky)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="84.0" y="488.0" width="469.2" height="61" as="geometry"/></mxCell>
