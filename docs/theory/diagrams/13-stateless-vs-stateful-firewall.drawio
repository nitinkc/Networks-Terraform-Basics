        <mxCell id="c45" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;Connection table (state)&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#11603E;&quot;&gt;TCP 10.0.0.5:51000 → 203.0.113.9:443   ESTABLISHED&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#8E1B1B;&quot;&gt;unsolicited SYN from outside → no entry → DROP&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="740.0" y="488.0" width="444.0" height="61" as="geometry"/></mxCell>
