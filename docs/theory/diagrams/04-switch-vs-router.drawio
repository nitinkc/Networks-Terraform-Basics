        <mxCell id="c91" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;REMEMBER&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="958.0" width="97.4" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c92" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Switch: same network, MAC table, floods unknowns.   Router: different networks, routing table, drops broadcasts.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="949.0" width="964.8" height="21" as="geometry"/></mxCell>
        <mxCell id="c93" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;L3 addresses are end-to-end; L2 addresses are only valid for the current hop.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="973.0" width="670.8" height="21" as="geometry"/></mxCell>
