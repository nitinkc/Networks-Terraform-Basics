        <mxCell id="c34" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#11603E;strokeWidth=1.5;fontColor=#fff;fillColor=#1E9A63;rounded=1;absoluteArcSize=1;arcSize=16;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1226.4" y="239.6" width="51.2" height="37.1" as="geometry"/></mxCell>
        <mxCell id="c35" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#FFFFFF;strokeWidth=0.5;fontColor=#fff;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=6;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1248.2" y="251.1" width="7.7" height="11.5" as="geometry"/></mxCell>
        <mxCell id="c36" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2B2D8F;&quot;&gt;Browser checks&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;✓ chain leads to a trusted root&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;✓ hostname matches the certificate&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;✓ not expired · not revoked · signature valid&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#6366F1;strokeWidth=2;fontColor=#2B2D8F;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=20;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="870.0" y="540.0" width="426.0" height="128.0" as="geometry"/></mxCell>
        <mxCell id="c37" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;ASYMMETRIC → SYMMETRIC: WHY THE SWITCH MID-HANDSHAKE&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="726.0" width="435.8" height="17" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Asymmetric (key pair)&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;public key / private key&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;slow · used to prove identity&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;and agree on a shared secret&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#F1E9FE;gradientColor=#E3D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="760.0" width="400.0" height="110.0" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2F3846;&quot;&gt;then&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#2F3846;&quot;&gt;→&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=2;fontColor=#2F3846;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="480.0" y="760.0" width="140.0" height="110.0" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;Symmetric (one shared key)&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;AES / ChaCha20&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;fast · used to encrypt all the&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;actual HTTP traffic&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="656.0" y="760.0" width="400.0" height="110.0" as="geometry"/></mxCell>
        <mxCell id="c41" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;HTTPS port&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#E8890C;&quot;&gt;443&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;HTTP is 80&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1092.0" y="760.0" width="224.0" height="110.0" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;THE HTTP CONVERSATION INSIDE THE TUNNEL&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="906.0" width="332.9" height="17" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#1C3F94;letter-spacing:1.2px;&quot;&gt;REQUEST&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#1C3F94;&quot;&gt;GET /index.html HTTP/1.1&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#5B6677;&quot;&gt;Host: example.com&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#5B6677;&quot;&gt;Accept: text/html&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#5B6677;&quot;&gt;Cookie: session=…&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=20;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="940.0" width="500.0" height="140.0" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#11603E;letter-spacing:1.2px;&quot;&gt;RESPONSE&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#11603E;&quot;&gt;HTTP/1.1 200 OK&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#5B6677;&quot;&gt;Content-Type: text/html&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#5B6677;&quot;&gt;Content-Length: 1256&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#5B6677;&quot;&gt;&amp;lt;html&amp;gt;…&amp;lt;/html&amp;gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=20;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="580.0" y="940.0" width="500.0" height="140.0" as="geometry"/></mxCell>
        <mxCell id="c45" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;2xx  success&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#166F47;strokeWidth=2;fontColor=#FFFFFF;fillColor=#1E9A63;gradientColor=#1A8455;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1116.0" y="940.0" width="200.0" height="32.0" as="geometry"/></mxCell>
        <mxCell id="c46" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;3xx  redirect&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#2250A1;strokeWidth=2;fontColor=#FFFFFF;fillColor=#2F6FE0;gradientColor=#285FC1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1116.0" y="976.0" width="200.0" height="32.0" as="geometry"/></mxCell>
        <mxCell id="c47" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;4xx  client error&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1116.0" y="1012.0" width="200.0" height="32.0" as="geometry"/></mxCell>
        <mxCell id="c48" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;5xx  server error&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9C2D2D;strokeWidth=2;fontColor=#FFFFFF;fillColor=#D93F3F;gradientColor=#BB3636;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1116.0" y="1048.0" width="200.0" height="32.0" as="geometry"/></mxCell>
        <mxCell id="c49" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#E6C229;strokeWidth=2;fontColor=#5F4C00;fillColor=#FFF8D6;gradientColor=#FBEFBA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="1134.0" width="1272.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c50" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;REMEMBER&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="1158.0" width="97.4" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c51" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;TLS gives confidentiality, integrity and server identity. Certificates chain up to a root your device already trusts.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1149.0" width="1006.8" height="21" as="geometry"/></mxCell>
        <mxCell id="c52" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Methods: GET read · POST create · PUT replace · DELETE remove. Status class tells you who is at fault: 4xx you, 5xx server.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1173.0" width="1057.2" height="21" as="geometry"/></mxCell>
