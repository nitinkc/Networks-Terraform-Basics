        <mxCell id="c25" value="Why you can trust the certificate" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=12;html=1;collapsible=0;fillColor=#4F46E5;gradientColor=#443CC5;swimlaneFillColor=#E9EAFE;strokeColor=#6366F1;strokeWidth=2.5;fontColor=#FFFFFF;fontStyle=1;fontSize=17;align=left;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="130" width="466" height="560" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;Root CA&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#AF5858;&quot;&gt;pre-installed in your OS/browser&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=2;fontColor=#8E1B1B;fillColor=#FDE8E8;gradientColor=#FBD1D1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="890.0" y="190.0" width="300.0" height="74.0" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Intermediate CA&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27742;&quot;&gt;signed by the root&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFF0DC;gradientColor=#FDE4BF;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="890.0" y="302.0" width="300.0" height="74.0" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;example.com certificate&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#508D72;&quot;&gt;signed by the intermediate&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="890.0" y="414.0" width="300.0" height="74.0" as="geometry"/></mxCell>
