        <mxCell id="c12" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;ClientHello&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="371.8" y="305.0" width="116.4" height="21" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;TLS versions · cipher suites · key share · SNI=example.com&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="191.8" y="336.0" width="476.4" height="21" as="geometry"/></mxCell>
        <mxCell id="c14" value="" style="html=1;strokeColor=#1E9A63;strokeWidth=3.5;rounded=1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="688.0" y="420.0" as="sourcePoint"/><mxPoint x="172.0" y="420.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;ServerHello + Certificate + key share + Finished&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="216.4" y="395.0" width="427.2" height="21" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;picks cipher · sends certificate chain · proves it owns the key&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="172.3" y="426.0" width="515.4" height="21" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Client verifies&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;chain · name · dates · signature&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="180.0" y="452.0" width="240.0" height="62.0" as="geometry"/></mxCell>
