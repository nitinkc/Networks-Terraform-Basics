        <mxCell id="c19" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;Finished&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="384.4" y="535.0" width="91.2" height="21" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;both sides now derive the same session keys&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="250.3" y="566.0" width="359.4" height="21" as="geometry"/></mxCell>
