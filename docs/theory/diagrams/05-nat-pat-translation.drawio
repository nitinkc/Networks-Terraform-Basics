        <mxCell id="c40" value="&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#11603E;&quot;&gt;192.168.1.100:80&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=1;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="134.0" y="698.0" width="220.0" height="40.0" as="geometry"/></mxCell>
        <mxCell id="c41" value="&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#11603E;&quot;&gt;198.51.100.1:8080&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=1;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="698.0" width="230.0" height="40.0" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#11603E;&quot;&gt;any&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=1;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="584.0" y="698.0" width="190.0" height="40.0" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;Return packet arrives with dst 198.51.100.1:51001 → table lookup → rewritten to 192.168.1.11:51000.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="748.0" width="693.2" height="18" as="geometry"/></mxCell>
        <mxCell id="c44" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="790.0" width="730.0" height="128.0" as="geometry"/></mxCell>
        <mxCell id="c45" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;Static PAT = port forwarding (the green row)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="64.0" y="802.0" width="467.5" height="26" as="geometry"/></mxCell>
        <mxCell id="c46" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2F3846;&quot;&gt;Internet client&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;connects to :8080&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=2;fontColor=#2F3846;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="64.0" y="846.0" width="190.0" height="54.0" as="geometry"/></mxCell>
        <mxCell id="c47" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;198.51.100.1:8080&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;R1 outside&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="300.0" y="846.0" width="200.0" height="54.0" as="geometry"/></mxCell>
        <mxCell id="c48" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;192.168.1.100:80&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;internal web server&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="546.0" y="846.0" width="210.0" height="54.0" as="geometry"/></mxCell>
        <mxCell id="c49" value="" style="html=1;strokeColor=#5B6677;strokeWidth=3;rounded=1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="254.0" y="873.0" as="sourcePoint"/><mxPoint x="300.0" y="873.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c50" value="" style="html=1;strokeColor=#5B6677;strokeWidth=3;rounded=1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500.0" y="873.0" as="sourcePoint"/><mxPoint x="546.0" y="873.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c51" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;THE FOUR CISCO TERMS&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="810.0" y="548.0" width="182.4" height="17" as="geometry"/></mxCell>
        <mxCell id="c52" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;Inside local&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#1C3F94;&quot;&gt;192.168.1.10&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5974B4;&quot;&gt;inside host, seen from inside&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#E8F1FF;gradientColor=#CFE1FE;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="810.0" y="578.0" width="248.0" height="100.0" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Inside global&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#7A4300;&quot;&gt;198.51.100.1&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27742;&quot;&gt;same host, seen from outside&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFF0DC;gradientColor=#FDE4BF;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1066.0" y="578.0" width="248.0" height="100.0" as="geometry"/></mxCell>
        <mxCell id="c54" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;Outside global&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#11603E;&quot;&gt;203.0.113.50&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#508D72;&quot;&gt;outside host, seen from outside&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="810.0" y="686.0" width="248.0" height="100.0" as="geometry"/></mxCell>
        <mxCell id="c55" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#0B5E5A;&quot;&gt;Outside local&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#0B5E5A;&quot;&gt;203.0.113.50&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#4B8C88;&quot;&gt;outside host, seen from inside&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#20B2AA;strokeWidth=2;fontColor=#0B5E5A;fillColor=#DFF6F5;gradientColor=#C0EBE9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1066.0" y="686.0" width="248.0" height="100.0" as="geometry"/></mxCell>
        <mxCell id="c56" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2F3846;&quot;&gt;Inside / outside is about WHERE the host lives;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2F3846;&quot;&gt;local / global is about WHO is looking at the address.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#8B95A5;strokeWidth=2;fontColor=#2F3846;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="810.0" y="802.0" width="504.0" height="94.0" as="geometry"/></mxCell>
        <mxCell id="c57" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#E6C229;strokeWidth=2;fontColor=#5F4C00;fillColor=#FFF8D6;gradientColor=#FBEFBA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="994.0" width="1272.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c58" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;REMEMBER&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="1018.0" width="97.4" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c59" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;NAT swaps addresses · PAT also swaps ports so thousands of hosts share one public IP (the &#x27;overload&#x27; keyword).&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1009.0" width="948.0" height="21" as="geometry"/></mxCell>
        <mxCell id="c60" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Outbound creates the table row; unsolicited inbound has no row → dropped, unless you add a static PAT row.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1033.0" width="914.4" height="21" as="geometry"/></mxCell>
