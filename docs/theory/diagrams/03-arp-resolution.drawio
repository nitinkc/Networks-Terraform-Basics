        <mxCell id="c45" value="&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;FF:FF:FF:FF:FF:FF = ‘everyone on this LAN’&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;Type 0x0806 = ARP (not IP) — ARP rides directly on Ethernet&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="490.0" y="902.0" width="422.8" height="36" as="geometry"/></mxCell>
        <mxCell id="c46" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFF0DC;gradientColor=#FDE4BF;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1016.0" y="790.0" width="300.0" height="180.0" as="geometry"/></mxCell>
        <mxCell id="c47" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;ARP stops at the router&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;Broadcast domains end&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;at Layer 3 boundaries:&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1036.0" y="802.0" width="255.8" height="62" as="geometry"/></mxCell>
        <mxCell id="c48" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;LAN 1&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=40.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1036.0" y="880.0" width="90.0" height="40.0" as="geometry"/></mxCell>
        <mxCell id="c49" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;R&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=40.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1140.0" y="880.0" width="70.0" height="40.0" as="geometry"/></mxCell>
        <mxCell id="c50" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;LAN 2&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=40.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1224.0" y="880.0" width="72.0" height="40.0" as="geometry"/></mxCell>
        <mxCell id="c51" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#8E1B1B;letter-spacing:1.2px;&quot;&gt;✗ broadcast blocked&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1038.8" y="926.0" width="174.5" height="17" as="geometry"/></mxCell>
        <mxCell id="c52" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#E6C229;strokeWidth=2;fontColor=#5F4C00;fillColor=#FFF8D6;gradientColor=#FBEFBA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="1004.0" width="1272.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;REMEMBER&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="1028.0" width="97.4" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c54" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;IP = which network (changes per network) · MAC = which device on this wire (rewritten at every hop).&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1019.0" width="864.0" height="21" as="geometry"/></mxCell>
        <mxCell id="c55" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;ARP = broadcast question, unicast answer, then cache. Unauthenticated → ARP spoofing; defence = Dynamic ARP Inspection.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1043.0" width="1023.6" height="21" as="geometry"/></mxCell>
