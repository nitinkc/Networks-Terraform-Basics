        <mxCell id="c13" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;namespace · cloud credentials&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#B05F5F;&quot;&gt;GCP service-account key XC uses to deploy the CE&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=2;fontColor=#8E1B1B;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="742.0" y="318.0" width="548.0" height="84.0" as="geometry"/></mxCell>
