        <mxCell id="c24" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="776.0" width="24.0" height="17" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2B2D8F;&quot;&gt;Landing zone exists&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#6466B0;&quot;&gt;VPCs, subnets, NAT, firewall, private origin&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#6366F1;strokeWidth=2;fontColor=#2B2D8F;fillColor=#E9EAFE;gradientColor=#D4D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=60;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="806.0" width="640.0" height="54.0" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;1&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#3932A5;strokeWidth=2;fontColor=#FFFFFF;fillColor=#4F46E5;gradientColor=#443CC5;gradientDirection=south;ellipse;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="59.0" y="818.0" width="30.0" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2B2D8F;&quot;&gt;XC gets cloud credentials + site spec&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#6466B0;&quot;&gt;namespace and gcp_vpc_site created&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#6366F1;strokeWidth=2;fontColor=#2B2D8F;fillColor=#E9EAFE;gradientColor=#D4D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=60;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="868.0" width="640.0" height="54.0" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;2&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#3932A5;strokeWidth=2;fontColor=#FFFFFF;fillColor=#4F46E5;gradientColor=#443CC5;gradientDirection=south;ellipse;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="59.0" y="880.0" width="30.0" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2B2D8F;&quot;&gt;Deploy action fires&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#6466B0;&quot;&gt;XC backend provisions the CE VM with its 2 NICs&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#6366F1;strokeWidth=2;fontColor=#2B2D8F;fillColor=#E9EAFE;gradientColor=#D4D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=60;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="930.0" width="640.0" height="54.0" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;3&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#3932A5;strokeWidth=2;fontColor=#FFFFFF;fillColor=#4F46E5;gradientColor=#443CC5;gradientDirection=south;ellipse;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="59.0" y="942.0" width="30.0" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2B2D8F;&quot;&gt;CE registers, site goes UP&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#6466B0;&quot;&gt;token → pending → auto-approved by the action&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#6366F1;strokeWidth=2;fontColor=#2B2D8F;fillColor=#E9EAFE;gradientColor=#D4D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=60;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="992.0" width="640.0" height="54.0" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;4&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#3932A5;strokeWidth=2;fontColor=#FFFFFF;fillColor=#4F46E5;gradientColor=#443CC5;gradientDirection=south;ellipse;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="59.0" y="1004.0" width="30.0" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2B2D8F;&quot;&gt;Pool, WAF and LB attach to the site&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#6466B0;&quot;&gt;traffic path is now complete&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#6366F1;strokeWidth=2;fontColor=#2B2D8F;fillColor=#E9EAFE;gradientColor=#D4D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=60;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="1054.0" width="640.0" height="54.0" as="geometry"/></mxCell>
        <mxCell id="c34" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;5&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#3932A5;strokeWidth=2;fontColor=#FFFFFF;fillColor=#4F46E5;gradientColor=#443CC5;gradientDirection=south;ellipse;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="59.0" y="1066.0" width="30.0" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c35" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;The payoff&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#5B6677;&quot;&gt;curl http://&amp;lt;lb-domain&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;→ private NGINX answers through the global VIP&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#5B6677;&quot;&gt;terraform destroy → both clouds cleaned up&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="720.0" y="806.0" width="596.0" height="140.0" as="geometry"/></mxCell>
        <mxCell id="c36" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;Who creates the CE VM?&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;Not your google provider. volterra_gcp_vpc_site stores a spec;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;the deploy action makes XC run its own apply using the&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;service account in volterra_cloud_credentials.&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=2;fontColor=#8E1B1B;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="720.0" y="966.0" width="596.0" height="120.0" as="geometry"/></mxCell>
        <mxCell id="c37" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#E6C229;strokeWidth=2;fontColor=#5F4C00;fillColor=#FFF8D6;gradientColor=#FBEFBA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="1184.0" width="1272.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;REMEMBER&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="1208.0" width="97.4" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Two planes, one command: google builds your VPC world, volterra describes the XC world, XC builds the CE between.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1199.0" width="973.2" height="21" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Lab 02 did this by hand; every Console click above maps to one resource block here.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1223.0" width="721.2" height="21" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
