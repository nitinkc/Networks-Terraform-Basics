        <mxCell id="c7" value="GCP PLANE · google provider" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=12;html=1;collapsible=0;fillColor=#2F6FE0;gradientColor=#285FC1;swimlaneFillColor=#E8F1FF;strokeColor=#4C8DF6;strokeWidth=2.5;fontColor=#FFFFFF;fontStyle=1;fontSize=17;align=left;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="260" width="600" height="470" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#1C3F94;&quot;&gt;VPCs + subnets&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#6079B4;&quot;&gt;xc-outside-vpc / xc-inside-vpc&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#4C8DF6;strokeWidth=2;fontColor=#1C3F94;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="70.0" y="318.0" width="548.0" height="84.0" as="geometry"/></mxCell>
