        <mxCell id="c3" value="&lt;div style=&quot;font-size:32px;line-height:40px;font-weight:700;font-family:Helvetica;color:#1F2A44;&quot;&gt;F5 XC Lab 04: how the two planes cooperate in one apply&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="28.0" width="1060.0" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;font-size:17px;line-height:24px;font-family:Helvetica;color:#5B6677;&quot;&gt;Your google provider builds the landing zone; XC&#x27;s own backend builds the Customer Edge VM. Terraform just orders the dependencies&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="72.0" width="1060.0" height="24" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;F5 XC LAB 04 · AUTOMATION&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#3932A5;strokeWidth=2;fontColor=#FFFFFF;fillColor=#4F46E5;gradientColor=#443CC5;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1078.0" y="30.0" width="238.0" height="30.0" as="geometry"/></mxCell>
