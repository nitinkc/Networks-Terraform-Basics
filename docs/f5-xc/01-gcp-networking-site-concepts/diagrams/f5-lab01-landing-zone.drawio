        <mxCell id="c7" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;CE node NIC 0 attaches here in Lab 02&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;public / ephemeral IP, dials out to F5&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;nothing is deployed yet — only the landing zone&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;dashed=1;dashPattern=9 7;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="70.0" y="190.0" width="508.0" height="130.0" as="geometry"/></mxCell>
