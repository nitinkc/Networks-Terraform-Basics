        <mxCell id="c6" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;One Terraform project&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#FFFFFF;&quot;&gt;one dependency graph · one terraform.tfstate&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#3932A5;strokeWidth=2;fontColor=#FFFFFF;fillColor=#4F46E5;gradientColor=#443CC5;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="480.0" y="140.0" width="400.0" height="120.0" as="geometry"/></mxCell>
