        <mxCell id="c55" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Private VM opens a connection&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27742;&quot;&gt;src 192.168.20.x → internet:443&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFF0DC;gradientColor=#FDE4BF;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=60;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="646.0" width="640.0" height="56.0" as="geometry"/></mxCell>
