        <mxCell id="c13" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;hub-to-prod peering&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#59379E;strokeWidth=1.5;fontColor=#FFFFFF;fillColor=#7C4DDB;rounded=1;absoluteArcSize=1;arcSize=26.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="590.2" y="187.0" width="179.6" height="26.0" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#FFFFFF;&quot;&gt;prod-to-hub peering&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#59379E;strokeWidth=1.5;fontColor=#FFFFFF;fillColor=#7C4DDB;rounded=1;absoluteArcSize=1;arcSize=26.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="590.2" y="251.0" width="179.6" height="26.0" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Both halves are required&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;one side alone stays INACTIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;2 × google_compute_network_peering&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="340.0" width="320.0" height="90.0" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;NON-TRANSITIVE: A↔B and B↔C does NOT give A↔C&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="500.0" width="380.4" height="17" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#11603E;&quot;&gt;VPC A · prod&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#5B6677;&quot;&gt;10.10.0.0/16&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#34B27B;strokeWidth=2;fontColor=#11603E;fillColor=#E4F7EC;gradientColor=#C8ECDA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="540.0" width="300.0" height="90.0" as="geometry"/></mxCell>
