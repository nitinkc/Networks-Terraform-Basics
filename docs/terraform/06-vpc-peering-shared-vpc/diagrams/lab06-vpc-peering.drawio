        <mxCell id="c25" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;no transit ✗&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=1.5;fontColor=#8E1B1B;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=26.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="619.6" y="687.0" width="120.8" height="26.0" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;PEERING CHECKLIST&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="750.0" width="158.6" height="17" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#8E1B1B;&quot;&gt;No overlapping CIDRs&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#AF5858;&quot;&gt;10.0.0.0/16 and 10.10.0.0/16 are distinct&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#EF5B5B;strokeWidth=2;fontColor=#8E1B1B;fillColor=#FDE8E8;gradientColor=#FBD1D1;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="782.0" width="306.0" height="90.0" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#4B2A9A;&quot;&gt;Create both directions&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#7D63B8;&quot;&gt;each VPC must peer to the other&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#9B6CF0;strokeWidth=2;fontColor=#4B2A9A;fillColor=#F1E9FE;gradientColor=#E3D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="362.0" y="782.0" width="306.0" height="90.0" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;Add firewall rules&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#A27742;&quot;&gt;peering opens routes, not ports&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFF0DC;gradientColor=#FDE4BF;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="680.0" y="782.0" width="306.0" height="90.0" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#0B5E5A;&quot;&gt;Private IP only&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#4B8C88;&quot;&gt;traffic stays on Google&#x27;s network&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#20B2AA;strokeWidth=2;fontColor=#0B5E5A;fillColor=#DFF6F5;gradientColor=#C0EBE9;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="998.0" y="782.0" width="306.0" height="90.0" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#2B2D8F;letter-spacing:1.2px;&quot;&gt;VERIFY&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="900.0" width="71.5" height="17" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#E2E8F0;&quot;&gt;gcloud compute networks peerings list&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#0B1220;strokeWidth=2;fontColor=#E2E8F0;fillColor=#1F2A44;rounded=1;absoluteArcSize=1;arcSize=36.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="930.0" width="346.2" height="36.0" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#E2E8F0;&quot;&gt;ping 10.10.0.x (from the hub VM)&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#0B1220;strokeWidth=2;fontColor=#E2E8F0;fillColor=#1F2A44;rounded=1;absoluteArcSize=1;arcSize=36.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="400.2" y="930.0" width="303.2" height="36.0" as="geometry"/></mxCell>
        <mxCell id="c34" value="" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#E6C229;strokeWidth=2;fontColor=#5F4C00;fillColor=#FFF8D6;gradientColor=#FBEFBA;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=32;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="1024.0" width="1272.0" height="78.0" as="geometry"/></mxCell>
        <mxCell id="c35" value="&lt;div style=&quot;font-size:12px;line-height:17px;font-weight:700;font-family:Helvetica;color:#FFFFFF;letter-spacing:1.2px;&quot;&gt;REMEMBER&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#A76309;strokeWidth=2;fontColor=#FFFFFF;fillColor=#E8890C;gradientColor=#C8760A;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=30.0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="1048.0" width="97.4" height="30.0" as="geometry"/></mxCell>
        <mxCell id="c36" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Peering = private connectivity between two VPCs. Routes are exchanged; firewall policy, IAM and administration stay separate.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1039.0" width="1074.0" height="21" as="geometry"/></mxCell>
        <mxCell id="c37" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#5F4C00;&quot;&gt;Need many-to-many or central control? Use Shared VPC or a hub with VPN/NCC instead of a peering mesh.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="177.4" y="1063.0" width="872.4" height="21" as="geometry"/></mxCell>
