        <mxCell id="c3" value="&lt;div style=&quot;font-size:32px;line-height:40px;font-weight:700;font-family:Helvetica;color:#1F2A44;&quot;&gt;Terraform Lab 06 — VPC Network Peering&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="28.0" width="1060.0" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;font-size:17px;line-height:24px;font-family:Helvetica;color:#5B6677;&quot;&gt;Peering links two VPCs privately and exchanges routes — but it is never transitive and never merges firewalls&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="72.0" width="1060.0" height="24" as="geometry"/></mxCell>
