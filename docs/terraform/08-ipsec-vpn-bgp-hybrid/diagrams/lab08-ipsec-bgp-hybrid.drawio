        <mxCell id="c64" value="&lt;div style=&quot;font-size:15px;line-height:21px;font-weight:700;font-family:Helvetica;color:#2B2D8F;&quot;&gt;BGP session over 169.254.0.0/30&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#6466B0;&quot;&gt;AS 65001 ↔ AS 65000: Idle → Active → Established&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#6366F1;strokeWidth=2;fontColor=#2B2D8F;fillColor=#E9EAFE;gradientColor=#D4D5FC;gradientDirection=south;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=60;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="686.0" width="640.0" height="54.0" as="geometry"/></mxCell>
