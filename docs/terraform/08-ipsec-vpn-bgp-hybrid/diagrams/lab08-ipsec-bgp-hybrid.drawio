        <mxCell id="c72" value="&lt;div style=&quot;font-size:18px;line-height:26px;font-weight:700;font-family:Helvetica;color:#7A4300;&quot;&gt;BGP advertisements&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#1C3F94;&quot;&gt;10.1.0.0/16   → learned by Cloud Router&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;font-weight:500;font-family:Courier New;color:#11603E;&quot;&gt;10.200.0.0/16 → learned by Cisco router&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:18px;font-weight:400;font-family:Helvetica;color:#5B6677;&quot;&gt;no static routes to maintain&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#F5A524;strokeWidth=2;fontColor=#7A4300;fillColor=#FFFFFF;rounded=1;absoluteArcSize=1;arcSize=28;align=left;spacingLeft=20;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="720.0" y="562.0" width="596.0" height="120.0" as="geometry"/></mxCell>
